# Copy to .env. Read by Docker Compose, the Django settings and Vite.

# --- Database (also used by the postgis container on first start) ---
POSTGRES_DB=huni
POSTGRES_USER=huni
POSTGRES_PASSWORD=huni
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Only if GeoDjango can't find the native libs (e.g. Homebrew on macOS):
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# --- Web ---
# Any MapLibre style JSON URL. OpenFreeMap needs no API key.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Where the Vite dev server proxies /api to.
API_PROXY_TARGET=http://localhost:8000
